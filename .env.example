# --- Proxy (mainland-China users only) ---
# Local proxy for ccxt to reach overseas exchanges. Leave blank if your
# server can reach Binance/OKX/Bybit directly (e.g. JP / SG / US hosting).
# 国内用户填本地代理 (Clash 默认 7890, Shadowsocks 默认 1080 等)。
HTTPS_PROXY=
HTTP_PROXY=

# --- Basic Auth (recommended for public deployments) ---
# Set both to enable HTTP Basic Auth on the entire dashboard, including
# the /ws WebSocket endpoint. Leave blank for an unauthenticated dashboard.
# 公开部署强烈建议设置；都留空即关闭认证。
AUTH_USER=
AUTH_PASS=
